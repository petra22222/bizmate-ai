{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, small business settings, role and plan",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "businessName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session with n8n AI Agent",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messageCount": { "type": "number" },
        "lastMessageSnippet": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "title", "userId", "createdAt", "updatedAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Single message exchanged with the AI assistant or n8n workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "delivered", "error", "pending"] },
        "structuredData": { "type": "object" }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "createdAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and chat settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "theme": { "type": "string", "enum": ["dark", "light", "system"] },
        "enterToSend": { "type": "boolean" },
        "showTimestamps": { "type": "boolean" },
        "compactMode": { "type": "boolean" },
        "emailNotifications": { "type": "boolean" },
        "n8nCustomUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles, roles, and plan info"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Stores user configuration and preferences"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Stores chat conversation sessions for the user"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Stores individual messages within a conversation"
    }
  }
}
